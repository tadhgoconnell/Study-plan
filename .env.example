# Copy this file to .env.local and fill in what you need.
# .env.local is git-ignored. Never commit real keys.

# --- Claude API (powers the AI assistant, AI plans and timetable upload) -----
# SECRET. Server only. Get a key at https://console.anthropic.com/settings/keys
# Without it the app still works: the built-in planner schedules and adapts
# your week, but the chat assistant and timetable upload are switched off.
ANTHROPIC_API_KEY=

# Optional. Which Claude model to use. Default: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Database ---------------------------------------------------------------
# Leave empty to store everything in a local database file (.data/ folder).
# For a hosted deployment (Vercel etc.) set a Postgres connection string,
# e.g. Supabase -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL=

# --- Access -----------------------------------------------------------------
# Optional but strongly recommended when the app is on the public internet:
# anyone opening the site must enter this password first.
APP_PASSWORD=
